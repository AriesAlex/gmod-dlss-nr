diff --git a/src/vkmirror.inc b/src/vkmirror.inc
index 8f21f435262b627b8445c215bc975e96205d6312..f5df6ed62b0896c96184cc38e815941bfbc35333 100644
--- a/src/vkmirror.inc
+++ b/src/vkmirror.inc
@@ -241,6 +241,7 @@ static const DWORD kVkmIdleMs      = kVkmSeeCopiesMs + kVkmEvaluateMs + 200;
 
 struct VkMirror
 {
+    ULONGLONG first_evaluate;
     bool    refused;     // and refused, or something later stood the mirror down
     // NOT the same thing as refused, and conflating the two retired the mirror
     // for the session every time a game changed display mode. ReShade destroys
@@ -1133,6 +1134,17 @@ static bool VkmEnsureEvents()
 // be replaced.
 static void VkMirrorFrame(void *cmd_raw, const NVSDK_NGX_Parameter *gp)
 {
+    // GMod can fault in studiorender when the private NR session is opened
+    // during map initialization. Let its own DLSS run first. Both this path
+    // and the reset in VkmNoteGameCreate hold g_bridge_cs.
+    const ULONGLONG now = GetTickCount64();
+    if (g_vkm.first_evaluate == 0)
+    {
+        g_vkm.first_evaluate = now;
+        Log("[vkmirror] GMod: warming up on game DLSS for 5 seconds before NR");
+    }
+    if (now - g_vkm.first_evaluate < 5000) return;
+
     // stage is a D3D11 word in the documentation and has grown two more meanings
     // since: below 3 the synthetic contract refuses, and below 2 the mirror does
     // not record a frame at all. The synthetic side says so twice; this returned
@@ -1153,6 +1165,18 @@ static void VkMirrorFrame(void *cmd_raw, const NVSDK_NGX_Parameter *gp)
     }
     if (g_vkm.refused || g_vkm.stopping) return;
 
+    // DLFG resets its own history on a camera cut. Parking that same reset
+    // command buffer behind the private D3D12 evaluate creates a queue cycle:
+    // the DLFG pacer waits for the reset submission while the submission waits
+    // for this mirror's host event. Let the game's already-forwarded DLSS result
+    // through for the reset frame and resume neural rendering on the next one.
+    int reset = 0;
+    if (gp != nullptr && gp->Get("Reset", &reset) == NGX_SUCCESS && reset != 0)
+    {
+        Log("[vkmirror] DLSS reset frame forwarded without mirroring so DLFG can reset its history");
+        return;
+    }
+
     if (g_vkm_rt == nullptr)
     {
         if (!g_vkm.said_no_runtime)
@@ -1939,6 +1963,7 @@ static void VkmNoteGameCreate(int feature_id, NVSDK_NGX_Result r,
     // line has to tell them apart or it reports a handover that did not happen --
     // the source did not change, the game replaced its own feature.
     g_vkm.rebuild_on_game_create = true;
+    g_vkm.first_evaluate = 0;
     LeaveCriticalSection(&g_bridge_cs);
 }
 
