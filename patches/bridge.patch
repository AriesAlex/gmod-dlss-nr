diff --git a/src/build.cmd b/src/build.cmd
index 81ab78a0a7e48853fdb12ee0407f2ef7a2254d0c..4ea6dd8550a65db5d429acb0f747d79465f5330d 100644
--- a/src/build.cmd
+++ b/src/build.cmd
@@ -1,13 +1,15 @@
 @echo off
-rem dlss5-bridge -- build. The exact line the README quotes; kept here because it
-rem has been retyped by hand once too often and lost a flag each time.
+rem Build the x64 ReShade addon with the installed Visual C++ toolchain.
 setlocal
-set VCVARS=C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools\VC\Auxiliary\Build\vcvars64.bat
+if not defined VCVARS (
+  for /f "usebackq delims=" %%i in (`"%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find VC\Auxiliary\Build\vcvars64.bat`) do set "VCVARS=%%i"
+)
 if not exist "%VCVARS%" (
   echo build.cmd: no vcvars64.bat at "%VCVARS%"
   exit /b 1
 )
-call "%VCVARS%" >nul 2>&1
+call "%VCVARS%" >nul
+if errorlevel 1 exit /b 1
 cd /d "%~dp0"
 
 rc /nologo version.rc
