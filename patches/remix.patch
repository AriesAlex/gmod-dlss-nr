index 0000000000000000000000000000000000000000..ab6437cf4d88d0509230928d688eb8fe2180af67
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/neural_rendering/neural_rendering.h
@@ -0,0 +1,72 @@
+/*
+* Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+*
