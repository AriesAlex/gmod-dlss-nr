* text=auto eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cs text eol=lf
# Patch context preserves upstream whitespace; review the applied source diff.
*.patch -text -whitespace
*.dll filter=lfs diff=lfs merge=lfs -text
*.addon64 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
